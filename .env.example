# --- LLM ---------------------------------------------------------------
# anthropic (Claude API, paid), groq or gemini (free cloud tiers),
# or ollama (free, runs on your machine; needs ~8 GB free RAM for a 7b model)
LLM_PROVIDER=anthropic

# Groq free tier: key at https://console.groq.com/keys (no credit card)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google AI Studio free tier: key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama: install from https://ollama.com, then `ollama pull qwen2.5-coder:7b`
OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192

# --- Warehouse ---------------------------------------------------------
# sqlite (default, zero setup) or snowflake
WAREHOUSE_BACKEND=sqlite
# SQLITE_PATH=data/warehouse.db

# --- Agent -------------------------------------------------------------
AGENT_MAX_ATTEMPTS=4
AGENT_PREVIEW_ROWS=20
RESULT_ROW_LIMIT=1000
QUERY_TIMEOUT_S=30

# --- Snowflake (only when WAREHOUSE_BACKEND=snowflake) ----------------
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=TEXT2SQL
SNOWFLAKE_SCHEMA=RETAIL
# Role used by the agent at query time; should be read-only
SNOWFLAKE_ROLE=TEXT2SQL_READER
# Role used once by warehouse/load_snowflake.py to create and load tables
SNOWFLAKE_ADMIN_ROLE=SYSADMIN
